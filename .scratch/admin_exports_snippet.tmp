740	export async function getAdminExports() {
741	  const role = await requireRole('admin');
742	  if (!role.ok) return role;
743	  const supabase = await createClient();
744	  const [{ data: approved, error: approvedError }, { data: history, error: historyError }] = await Promise.all([
745	    supabase
746	      .from('audit_records')
747	      .select('id,source_message_id,status,created_at,updated_at')
748	      .in('status', ['approved', 'exported'])
749	      .not('source_message_id', 'is', null)
750	      .order('created_at', { ascending: false }),
751	    supabase.from('export_batches').select('*').order('created_at', { ascending: false }),
752	  ]);
753	  if (approvedError) return fail('error', `可导出记录加载失败：${approvedError.message}`);
754	  if (historyError) return fail('error', `导出历史加载失败：${historyError.message}`);
755
756	  const latestByMessage = new Map<string, { id: string; status: string; created_at: string; updated_at: string }>();
757	  for (const record of approved ?? []) {
758	    if (!record.source_message_id) continue;
759	    const previous = latestByMessage.get(record.source_message_id);
760	    const recordTime = record.updated_at || record.created_at;
761	    const previousTime = previous ? previous.updated_at || previous.created_at : '';
762	    if (!previous || recordTime >= previousTime) latestByMessage.set(record.source_message_id, record);
763	  }
764
765	  const exportable = [...latestByMessage.values()].filter((record) => record.status === 'approved');
766	  return ok({ approved: exportable, history: history ?? [] });
767	}
768
769	export async function createExportBatch(formData: FormData): Promise<void> {
770	  const role = await requireRole('admin');
771	  if (!role.ok) return;
772	  const export_type = String(formData.get('export_type') ?? 'sft') as AuditKind;
773	  const supabase = await createClient();
774	  const query = supabase.from('audit_records').select('*').not('source_message_id', 'is', null);
775	  const { data: records, error } = export_type === 'review_metadata'
776	    ? await query.in('status', ['approved', 'exported'])
777	    : await query.eq('status', 'approved').eq('kind', export_type);
778	  if (error) return;
779	  if (!records?.length) return;
780
781	  const latestByMessage = new Map<string, (typeof records)[number]>();
782	  for (const record of records) {
783	    if (!record.source_message_id) continue;
784	    const previous = latestByMessage.get(record.source_message_id);
785	    const recordTime = record.updated_at || record.created_at;
786	    const previousTime = previous ? previous.updated_at || previous.created_at : '';
787	    if (!previous || recordTime >= previousTime) latestByMessage.set(record.source_message_id, record);
788	  }
789
790	  const latestRecords = [...latestByMessage.values()];
791	  if (!latestRecords.length) return;
792	  const jsonl = latestRecords.map((record) => {
793	    if (export_type === 'review_metadata') {
794	      return JSON.stringify({
795	        source_record_id: record.id,
796	        source_message_id: record.source_message_id,
797	        source_conversation_id: record.source_conversation_id,
798	        auditor_id: record.auditor_id,
799	        class_id: record.class_id,
800	        kind: record.kind,
801	        status: record.status,
802	        quality: record.quality,
803	        rationale: record.rationale,
804	        metadata: record.metadata,
805	        reviewed_at: record.updated_at,
806	      });
807	    }
808	    return export_type === 'sft'
809	      ? JSON.stringify({ prompt: record.prompt, completion: record.corrected_answer || record.original_answer, source_record_id: record.id })
810	      : JSON.stringify({ prompt: record.prompt, chosen: record.chosen_answer, rejected: record.rejected_answer, source_record_id: record.id, rationale: record.rationale });
811	  }).join('\n');
812	  const { error: insertError } = await supabase.from('export_batches').insert({ export_type, record_count: latestRecords.length, jsonl, created_by: role.data.id });
813	  if (insertError) return;
814	  if (export_type !== 'review_metadata') {
815	    await supabase.from('audit_records').update({ status: 'exported', exported_at: new Date().toISOString() }).in('id', latestRecords.map((record) => record.id));
816	  }
817	  revalidatePath('/admin/exports');
818	  revalidatePath('/admin');
819	}
